{
  "meta": {
    "facet_type": "record.document",
    "definition_version": 1,
    "family": "documents",
    "classification": "Sensitive",
    "validation_mode": "strict",
    "source_schema": "fixture/record.document",
    "payload_kind": "reference",
    "time_semantics": {
      "fact_time": {
        "pointer": "/date",
        "layout": "2006-01-02",
        "zone": "UTC"
      }
    },
    "identity_key": [
      "/path"
    ],
    "min_binding_assurance": "medium"
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "One file in a documents library: a pointer to the bytes, which stay in the library. The fixture's copy of the structural type, read in UTC.",
    "type": "object",
    "required": [
      "path",
      "sha256",
      "media_type",
      "bytes",
      "date",
      "source_time"
    ],
    "properties": {
      "bytes": {
        "type": "number"
      },
      "date": {
        "type": "string",
        "minLength": 1
      },
      "media_type": {
        "type": "string",
        "minLength": 1
      },
      "note": {
        "type": "string",
        "minLength": 1
      },
      "path": {
        "type": "string",
        "minLength": 1
      },
      "sha256": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[0-9a-f]{64}$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "source_time": {
        "type": "object",
        "required": [
          "value",
          "zone",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "zone": {
            "type": "string",
            "minLength": 1,
            "pattern": "^([A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "configuration",
              "assumption"
            ]
          }
        }
      }
    },
    "additionalProperties": false
  }
}
