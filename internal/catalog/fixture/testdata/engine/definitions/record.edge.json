{
  "meta": {
    "facet_type": "record.edge",
    "definition_version": 1,
    "kind": "event",
    "family": "notes",
    "classification": "Sensitive",
    "validation_mode": "strict",
    "source_schema": "fixture/record.edge",
    "time_semantics": {
      "fact_time": {
        "pointer": "/at",
        "layout": "2006-01-02 15:04",
        "zone": "UTC",
        "zone_pointer": "/source_time/offset"
      }
    },
    "identity_key": [
      "/id"
    ],
    "min_binding_assurance": "medium"
  },
  "handling": {
    "label": "{/text}"
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "An edge: a fact that joins facets, with or without words. `from` and `to` are lists of facet ids and `kind` says what the join means. The fixture's copy of the structural type, read in UTC.",
    "type": "object",
    "required": [
      "id",
      "at",
      "source_time"
    ],
    "properties": {
      "source_time": {
        "type": "object",
        "required": [
          "value",
          "zone",
          "offset",
          "basis"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "zone": {
            "type": "string",
            "minLength": 1,
            "pattern": "^([A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
          },
          "offset": {
            "type": "string",
            "pattern": "^[+-]([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "basis": {
            "type": "string",
            "enum": [
              "source",
              "configuration",
              "assumption"
            ]
          }
        }
      },
      "id": {
        "type": "string",
        "minLength": 1
      },
      "at": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "type": "string",
        "enum": [
          "about",
          "interpreted_from"
        ]
      },
      "from": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "to": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "about": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "pins": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "text": {
        "type": "string",
        "minLength": 1
      }
    },
    "anyOf": [
      {
        "required": [
          "text"
        ]
      },
      {
        "required": [
          "to"
        ]
      },
      {
        "required": [
          "about"
        ]
      },
      {
        "required": [
          "from"
        ]
      }
    ],
    "not": {
      "required": [
        "about",
        "to"
      ]
    },
    "additionalProperties": false
  }
}
